# ##########################################
# Angular Specific Artifacts
# ##########################################
# Compiled output directory
/angular-app/dist/
/angular-app/tmp/
/angular-app/out-tsc/
/angular-app/bazel-out/
/angular-app/output/

# Angular CLI local cache (introduced in Angular 13+)
/.angular/

# Testing coverage reports
/angular-app/coverage/

# End-to-end testing logs and outputs
/angular-app/e2e/main.js
/angular-app/e2e/main.js.map
/angular-app/e2e/chunk-*.js
/angular-app/e2e/chunk-*.js.map

# ##########################################
# Dependencies
# ##########################################
# Third-party packages managed by npm or Yarn
node_modules/

# ##########################################
# Logs and Runtime Files
# ##########################################
# System and server logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ##########################################
# OS & Editor Specific Files (Optional but Recommended)
# ##########################################
# macOS files
.DS_Store

# Windows files
Thumbs.db

# IDEs/Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
